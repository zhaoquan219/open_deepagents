{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-deepagents.local/models.schema.json",
  "title": "open_deepagents model catalog",
  "type": "object",
  "required": ["model", "provider"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "model": {
      "type": "string",
      "description": "Default model id in provider/model format."
    },
    "provider": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["models"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "options": {
            "type": "object",
            "description": "Provider-level ChatOpenAI keyword arguments. Unknown keys are ignored with a runtime warning.",
            "additionalProperties": true,
            "properties": {
              "api_key": { "type": "string" },
              "base_url": { "type": "string" },
              "default_headers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "timeout": { "type": ["number", "integer", "null"] },
              "max_retries": { "type": ["integer", "null"] },
              "extra_body": {
                "type": "object",
                "additionalProperties": true
              },
              "model_kwargs": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "models": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["model"],
              "description": "Model-level ChatOpenAI keyword arguments plus the UI-only display name. Unknown keys are ignored with a runtime warning.",
              "additionalProperties": true,
              "properties": {
                "name": { "type": "string" },
                "model": { "type": "string" },
                "temperature": { "type": ["number", "null"] },
                "extra_body": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
