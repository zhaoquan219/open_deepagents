# Copy to backend/.env.
# Keep this file small: most settings have safe defaults in code.

# Browser app origins allowed to call the API during local development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Product database for users, sessions, runs, and events.
# SQLite:
DATABASE_URL=sqlite+pysqlite:///./data/backend.db
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/open_deepagents
# MySQL:
# DATABASE_URL=mysql+pymysql://app:change-me@127.0.0.1:3306/open_deepagents?charset=utf8mb4

# Agent checkpoint/store backend. Options: sqlite, postgresql, memory.
# SQLite uses ./data/checkpoints.db unless DEEPAGENTS_CHECKPOINT_DATABASE_URL is set.
DEEPAGENTS_CHECKPOINT_BACKEND=sqlite
# DEEPAGENTS_CHECKPOINT_DATABASE_URL=sqlite+pysqlite:///./data/checkpoints.db
# DEEPAGENTS_CHECKPOINT_DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/open_deepagents_checkpoints

# Backend log level. Use debug to print every raw agent update event.
BACKEND_LOG_LEVEL=info

# Optional: disable login for a trusted local-only demo.
# ADMIN_AUTH_ENABLED=false
# Admin login. Change both values before sharing the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=change-me-too

# Model catalog. Copy backend/models.example.json to backend/models.json and
# fill provider keys there.
DEEPAGENTS_MODEL_CONFIG_PATH=./models.json

# Agent package entrypoint.
DEEPAGENTS_MAIN_AGENT=agents:AGENT

# Sandbox profile:
# - safe: state backend plus read-only /skills and /uploads mounts
# - files: filesystem workspace plus the same /skills and /uploads mounts
# - shell: local shell for trusted development only
DEEPAGENTS_SANDBOX_PROFILE=safe

# User-configurable roots. `DEEPAGENTS_SANDBOX_ROOT_DIR` is used by files/shell
# profiles; `/skills` and `/uploads` are mounted read-only for every profile.
DEEPAGENTS_SANDBOX_ROOT_DIR=./data/sandbox
DEEPAGENTS_UPLOAD_ROOT_DIR=./data/uploads
