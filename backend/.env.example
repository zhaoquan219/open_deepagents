# =============================================================================
# open_deepagents backend environment
# Copy this file to backend/.env and replace secrets before deployment.
# =============================================================================
#
# One file, two common modes:
# - Local dev: keep memory + safe sandbox.
# - Production: use durable LangGraph runtime persistence and explicit secrets.

# Application
APP_NAME=DeepAgents Agent Platform Backend
API_PREFIX=/api
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Leave ENVIRONMENT unset (defaults to development) unless you already have a
# durable runtime bundle wired through DEEPAGENTS_RUNTIME_FACTORY.
# ENVIRONMENT=production

# Database
DATABASE_URL=sqlite+pysqlite:///./data/backend.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/deepagents_platform

# Administrator access
ADMIN_AUTH_ENABLED=true
# Set ADMIN_AUTH_ENABLED=false for trusted local deployments that should open
# directly without the login screen. When auth is enabled, sessions are isolated
# by authenticated username. When auth is disabled, session history is shared.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional extra login users for development or internal deployments.
# JSON object is recommended. Comma-separated USERNAME=PASSWORD pairs also work.
ADMIN_USERS={}
ADMIN_TOKEN_SECRET=change-me-too
ADMIN_TOKEN_EXPIRE_MINUTES=720

# DeepAgents agent/model entrypoints
DEEPAGENTS_MAIN_AGENT=agents:AGENT
# Copy backend/models.example.json to backend/models.json and fill real keys.
DEEPAGENTS_MODEL_CONFIG_PATH=./models.json
DEEPAGENTS_AGENT_NAME=deepagents-web
DEEPAGENTS_DEBUG=false
DEEPAGENTS_RECURSION_LIMIT=500

# Runtime settings
# Default/local: keep `memory`.
# Production: use `postgres` with the official LangGraph persistence packages,
# or use `factory` with a custom checkpointer/store/cache bundle.
DEEPAGENTS_RUNTIME_DRIVER=memory
# Required for DEEPAGENTS_RUNTIME_DRIVER=sqlite or postgres. Must not equal
# DATABASE_URL because the product database has exactly four product tables.
DEEPAGENTS_RUNTIME_DATABASE_URL=
DEEPAGENTS_RUNTIME_FACTORY=

# Backward-compatible runtime settings
DEEPAGENTS_RUNTIME_PERSISTENCE=memory
DEEPAGENTS_RUNTIME_SPEC=
# Advanced compatibility escape hatch:
# DEEPAGENTS_CHECKPOINTER_SPEC=
# DEEPAGENTS_STORE_SPEC=
# DEEPAGENTS_CACHE_SPEC=

# Sandbox settings
# safe -> state backend
# files -> file tools under ./agents
# shell -> local shell plus file tools under ./agents
DEEPAGENTS_SANDBOX_PROFILE=safe

# Low-level sandbox backend overrides
# See ../docs/sandbox.md for backend kinds, path behavior, and safety notes.
DEEPAGENTS_SANDBOX_KIND=state
DEEPAGENTS_SANDBOX_ROOT_DIR=./agents
DEEPAGENTS_SANDBOX_VIRTUAL_MODE=true
DEEPAGENTS_SANDBOX_TIMEOUT=120
DEEPAGENTS_SANDBOX_MAX_OUTPUT_BYTES=100000
DEEPAGENTS_SANDBOX_INHERIT_ENV=false
# Optional JSON object passed into the local shell backend when enabled.
# Example: DEEPAGENTS_SANDBOX_ENV={"PYTHONUNBUFFERED":"1"}
DEEPAGENTS_SANDBOX_ENV={}
# Import spec for a custom DeepAgents backend object or class.
DEEPAGENTS_BACKEND_SPEC=

# Production-only explicit safety overrides. Keep false unless the deployment
# has a documented reason.
ALLOW_ANONYMOUS_PRODUCTION=false
ALLOW_FULL_PROMPT_AUDIT=false
DEEPAGENTS_SANDBOX_ALLOW_SHELL=false
DEEPAGENTS_SANDBOX_ALLOW_ENV_INHERIT=false
AUDIT_COMPILED_PROMPTS=hash
