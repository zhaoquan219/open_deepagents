# =============================================================================
# open_deepagents backend environment
# Copy this file to backend/.env and replace secrets before deployment.
# =============================================================================

# Application
APP_NAME=DeepAgents Agent Platform Backend
API_PREFIX=/api
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database
DATABASE_URL=sqlite+pysqlite:///./data/backend.db
# MySQL example:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/deepagents_platform

# Administrator access
ADMIN_AUTH_ENABLED=true
# Set ADMIN_AUTH_ENABLED=false for trusted local deployments that should open
# directly without the login screen. When auth is enabled, sessions are isolated
# by authenticated username. When auth is disabled, session history is shared.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional extra login users for development or internal deployments.
# JSON object is recommended. Comma-separated USERNAME=PASSWORD pairs also work.
ADMIN_USERS={}
ADMIN_TOKEN_SECRET=change-me-too
ADMIN_TOKEN_EXPIRE_MINUTES=720

# Uploads
UPLOAD_STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10000000

# DeepAgents agent/model entrypoints
DEEPAGENTS_MAIN_AGENT=agents:AGENT
# Copy backend/models.example.json to backend/models.json and fill real keys.
DEEPAGENTS_MODEL_CONFIG_PATH=./models.json
DEEPAGENTS_DEFAULT_MODEL=openai/gpt-5-4
DEEPAGENTS_DEBUG=false

# Sandbox backend
# See ../docs/sandbox.md for backend kinds, path behavior, and safety notes.
DEEPAGENTS_SANDBOX_KIND=state
DEEPAGENTS_SANDBOX_ROOT_DIR=./data
DEEPAGENTS_SANDBOX_VIRTUAL_MODE=true
DEEPAGENTS_SANDBOX_TIMEOUT=120
DEEPAGENTS_SANDBOX_MAX_OUTPUT_BYTES=100000
DEEPAGENTS_SANDBOX_INHERIT_ENV=false
DEEPAGENTS_SANDBOX_BACKEND_SPEC=
